@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Целевая архитектура «Будущее 2.0» — через 1 год

' ─────────────────────────────────────────────
' Пользователи
' ─────────────────────────────────────────────
Person(clinicOperator, "Оператор клиники", "Вводит данные пациентов, запрашивает ИИ-диагностику")
Person(analyst,        "Аналитик / Менеджер", "Строит отчёты и дашборды через портал самообслуживания")
Person(patient,        "Пациент", "Использует банковские и медицинские сервисы")

' ─────────────────────────────────────────────
' МЕДИЦИНСКИЙ ДОМЕН
' ─────────────────────────────────────────────
System_Boundary(medicalDomain, "Медицинский домен (Клиники)") {

    Container(clinicApp, "Медицинская Web-система", "React + Java","Современный интерфейс оператора. Заменяет устаревший PowerBuilder.")

    Container(medicalAPI, "Medical Domain API", "Java / Spring Boot", "Управление медданными пациентов. Аутентификация, авторизация, аудит доступа.")

    ContainerDb(medicalStorage, "Медицинское хранилище", "Cloud Object Storage + ClickHouse / PostgreSQL", "Медкарты, снимки, результаты исследований. Изолировано — не передаётся в общую аналитику.")
}

' ─────────────────────────────────────────────
' ИИ-ДОМЕН
' ─────────────────────────────────────────────
System_Boundary(aiDomain, "ИИ-домен") {

    Container(aiPlatform, "ИИ-платформа", "Python / FastAPI", "Сервисы диагностики, анализа медицинских изображений, предсказания рисков.")

    ContainerDb(mlRegistry, "Реестр ML-моделей", "MLflow Registry","Хранение, версионирование и аудит ML-моделей.")
}

' ─────────────────────────────────────────────
' ФИНТЕХ-ДОМЕН
' ─────────────────────────────────────────────
System_Boundary(fintechDomain, "Финтех-домен (Банк)") {

    Container(fintechSvc, "Финтех-сервисы", "Golang / Java", "Кредиты, счета, платежи, банковские операции. Работает независимо от медицины.")

    ContainerDb(fintechDB, "Финтех БД", "Cloud PostgreSQL", "Финансовые транзакции, счета, кредиты, данные клиентов.")

    ContainerDb(fintechDM, "Финтех витрина", "Snowflake Schema", "Агрегированные финансовые данные для аналитики. Обновляется через ELT.")
}

' ─────────────────────────────────────────────
' КОРПОРАТИВНЫЙ ДОМЕН (Головной офис)
' ─────────────────────────────────────────────
System_Boundary(corpDomain, "Корпоративный домен (Головной офис)") {

    Container(dataPortal, "Портал самообслуживания", "React + Python (FastAPI)", "Единая точка доступа к отчётности. Сотрудник строит отчёты в рамках своего уровня доступа без участия IT.")

    ContainerDb(cloudDWH, "Corporate Cloud DWH", "Snowflake / Azure Synapse", "Консолидированное хранилище для корпоративной аналитики. Без медкарт. Колоночное хранение — быстрые запросы.")

    Container(biPlatform, "BI-платформа", "Power BI (Premium)", "Готовые дашборды и кастомные отчёты. Подключён к Cloud DWH через DirectQuery.")

    Container(orchestrator, "Оркестратор данных", "Apache Airflow / Azure Data Factory", "Управляет ELT-пайплайнами. Загружает данные из доменов в Cloud DWH по расписанию и событиям.")
}

' ─────────────────────────────────────────────
' ИНТЕГРАЦИОННЫЙ СЛОЙ
' ─────────────────────────────────────────────
System_Boundary(integrationLayer, "Интеграционный слой") {

    Container(kafka, "Event Streaming Platform", "Apache Kafka / Azure Event Hub", "Асинхронный обмен событиями между доменами. Заменяет ESB. Лёгкое подключение новых бизнесов.")

    Container(apiGW, "API Gateway", "Kong / Azure APIM", "Единая точка входа для всех API. Аутентификация, rate limiting, роутинг, мониторинг.")
}

' ─────────────────────────────────────────────
' ВНЕШНИЕ СИСТЕМЫ (планируемые)
' ─────────────────────────────────────────────
System_Ext(pharmaExt,    "Фармкомпании (будущее)",     "Поставщики данных о препаратах")
System_Ext(medDeviceExt, "Производитель оборудования", "Данные с медицинских устройств")

' ─────────────────────────────────────────────
' СВЯЗИ — Медицинский домен
' ─────────────────────────────────────────────
Rel(clinicOperator, clinicApp,    "Работает в интерфейсе",       "HTTPS")
Rel(clinicApp,      medicalAPI,   "Читает/записывает данные",    "REST/HTTPS")
Rel(clinicApp,      aiPlatform,   "Запрашивает ИИ-диагностику", "REST/HTTPS")
Rel(medicalAPI,     medicalStorage, "Хранит медданные",          "SQL / S3 API")
Rel(medicalAPI,     kafka,         "Публикует события домена",   "Kafka Producer")

' ─────────────────────────────────────────────
' СВЯЗИ — ИИ-домен
' ─────────────────────────────────────────────
Rel(aiPlatform, medicalAPI,  "Запрашивает данные для анализа",   "gRPC / REST")
Rel(aiPlatform, mlRegistry,  "Загружает/версионирует модели",    "MLflow API")
Rel(aiPlatform, kafka,       "Публикует результаты диагностики", "Kafka Producer")

' ─────────────────────────────────────────────
' СВЯЗИ — Финтех-домен
' ─────────────────────────────────────────────
Rel(patient,     apiGW,       "Использует банковские сервисы", "HTTPS / Mobile")
Rel(apiGW,       fintechSvc,  "Маршрутизирует запросы",        "HTTPS")
Rel(fintechSvc,  fintechDB,   "Читает/записывает данные",      "SQL")
Rel(fintechSvc,  kafka,       "Публикует финансовые события",  "Kafka Producer")
Rel(fintechDM,   fintechDB,   "ELT: загружает для аналитики",  "SQL / Connector")

' ─────────────────────────────────────────────
' СВЯЗИ — Корпоративный домен
' ─────────────────────────────────────────────
Rel(analyst,      dataPortal,  "Строит и просматривает отчёты", "HTTPS")
Rel(dataPortal,   cloudDWH,    "Выполняет аналитические запросы", "SQL / REST")
Rel(dataPortal,   biPlatform,  "Встраивает дашборды",             "Embed API")
Rel(biPlatform,   cloudDWH,    "DirectQuery для отчётов",         "SQL")
Rel(orchestrator, kafka,       "Подписывается на события",        "Kafka Consumer")
Rel(orchestrator, cloudDWH,    "Загружает трансформированные данные", "SQL / Bulk Load")
Rel(orchestrator, fintechDM,   "Забирает агрегированные данные",  "SQL / API")

' ─────────────────────────────────────────────
' СВЯЗИ — Интеграционный слой
' ─────────────────────────────────────────────
Rel(apiGW, medicalAPI,  "Маршрутизирует", "HTTPS")
Rel(apiGW, aiPlatform,  "Маршрутизирует", "HTTPS")

' ─────────────────────────────────────────────
' СВЯЗИ — Внешние системы (будущее)
' ─────────────────────────────────────────────
Rel(pharmaExt,    kafka, "Передаёт данные о препаратах", "Kafka Producer (новый топик)")
Rel(medDeviceExt, kafka, "Передаёт данные с устройств",  "Kafka Producer (новый топик)")

@enduml
